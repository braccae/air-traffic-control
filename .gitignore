node_modules/
build/
/dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
.superpowers/
data/bin/
data/ansible-venv/

# Runtime host-cache SQLite — real homelab inventory, never track or publish.
data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal

# rclone remote secret-encryption key (generated if ATC_RCLONE_KEY is unset).
data/.rclone-key

# Agent scratch / skill working copies (like .superpowers/, never commit).
.agents/

# Editor config.
.vscode/

# One-off verification scratch (contains a real node id; sanitize before keeping).
.evidence-terminal-working.png
.verify-terminal.mjs

# Embedded copy of the Vite build for the Go binary. `just build-all` copies the
# real assets in; only .gitkeep is committed so a bare `go build` or
# `go test ./...` still works on a fresh clone that has never run a build.
/backend-go/webui/dist/*
!/backend-go/webui/dist/.gitkeep
